# Template file for 'void-vscodium'
pkgname=codium
version=1.135.06055
revision=2
only_for_archs="x86_64"
create_wrksrc=yes
hostmakedepends="tar"
depends="gtk+3 nss alsa-lib libXtst libsecret libxkbfile libxkbcommon at-spi2-core xdg-utils"
short_desc="VSCodium - Visual Studio Code without Microsoft branding/telemetry (binary)"
maintainer="qwerty qwerty <qwerty@qwerty.qwerty>"
license="MIT"
homepage="https://vscodium.com"
distfiles="https://github.com/VSCodium/vscodium/releases/download/${version}/VSCodium-linux-x64-${version}.tar.gz"
checksum=c09d8ac8dd7f52b09ee159ee24b440541dfd8f937a0f6f88cc428c78e48ee1f2
nostrip=yes # bundled Electron binaries, stripping can break them

# The official VSCodium tarball bundles helper ELF files for several
# architectures. Skip those files while retaining dependency scanning for
# the main x86_64 Electron/Codium binaries.
skiprdeps="
	/usr/lib/codium/resources/app/node_modules.asar.unpacked/@vscode/ripgrep-universal/bin/*/*
	/usr/lib/codium/resources/app/node_modules.asar.unpacked/@microsoft/mxc-sdk/bin/*/*
"

do_install() {
	vmkdir usr/lib/codium
	vcopy "*" usr/lib/codium

	vmkdir usr/bin
	ln -sf /usr/lib/codium/bin/codium ${DESTDIR}/usr/bin/codium

	vmkdir usr/share/pixmaps
	ln -sf /usr/lib/codium/resources/app/resources/linux/code.png \
		${DESTDIR}/usr/share/pixmaps/codium.png

	vmkdir usr/share/applications
	cat > ${DESTDIR}/usr/share/applications/codium.desktop <<EOF
[Desktop Entry]
Name=VSCodium
Comment=Code Editing. Redefined.
Exec=/usr/bin/codium --unity-launch %F
Icon=codium
Type=Application
StartupNotify=false
StartupWMClass=VSCodium
Categories=Utility;TextEditor;Development;IDE;
MimeType=text/plain;inode/directory;
EOF

	if [ -f resources/app/LICENSE.txt ]; then
		vlicense resources/app/LICENSE.txt
	fi
}
